# runtime state / caches (not identity)
.openclaw/
.clawhub/
.openclaw-cli-images/
# local memory backups (redundant with git history itself)
memory/_backups/
# secrets — NEVER commit
**/.secrets/
*.pem
*.key
.git-credentials
*.log
.DS_Store

# Obsidian per-vault local config (viewer state, not memory) — do not track
.obsidian/
